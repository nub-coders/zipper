# ── Telegram API Credentials ──────────────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org
API_ID=0
API_HASH=your_api_hash_here

# Bot token and username from @BotFather
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username_without_at

# ── Admin Access ──────────────────────────────────────────────────────────────
# Comma-separated Telegram User IDs with access to privileged commands (/broadcast, /stats, /users, /skip, /reboot)
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# ── Database Storage ──────────────────────────────────────────────────────────
# MongoDB connection URI (optional)
# Leave blank to use in-memory storage (resets on restart)
MONGO_URL=

# Require users to join support channels before using the bot (true/false)
FORCE_SUBSCRIBE=false

# ── Support & Community ────────────────────────────────────────────────────────
# Telegram support group URL or @username (default: https://t.me/nub_coder_s)
SUPPORT_GROUP=https://t.me/nub_coder_s

# Telegram updates channel URL or @username (default: https://t.me/nub_coders)
SUPPORT_CHANNEL=https://t.me/nub_coders

# ── Download & Extraction Resource Ceilings ───────────────────────────────────
# Maximum download size per file in bytes (default: 2147483648 = 2 GB)
MAX_DOWNLOAD_BYTES=2147483648

# Maximum total uncompressed extraction size in bytes (default: 1073741824 = 1 GB)
MAX_EXTRACT_BYTES=1073741824

# Maximum number of files allowed in an extracted archive
MAX_EXTRACT_ENTRIES=2000

# Maximum extraction timeout in seconds (default: 600s = 10 minutes)
MAX_EXTRACT_SECONDS=600

# ── NuLoader Cloud Storage (Archives > 2 GB) ──────────────────────────────────
# NuLoader endpoint for files exceeding Telegram's 2 GB limit
NULOADER_API_URL=https://files.nubcoders.com
NULOADER_API_KEY=

# Retention / Expiry Mode:
# days_7     = expires in 7 days, unlimited downloads
# downloads_5 = deleted after 5 downloads (30 day hard cap)
NULOADER_EXPIRY_MODE=days_7
