# Telegram API credentials from https://my.telegram.org
API_ID=0
API_HASH=your_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username_without_at

# Admin user IDs (comma-separated). If unset, falls back to admin.txt (public in git).
ADMIN_IDS=

# MongoDB connection URI (optional).
# Leave blank to use in-memory storage — data will not persist across restarts.
MONGO_URL=

# Require users to join the support channels before using the bot (true/false)
FORCE_SUBSCRIBE=true

# ── NuLoader (hosting for archives over Telegram's 2 GB limit) ────────────────
# When NULOADER_API_KEY is set, archives larger than 2 GB are uploaded to this
# NuLoader instance and the user gets a download link. Leave the key blank to
# fall back to gofile.io (the previous behaviour).
NULOADER_API_URL=https://files.nubcoders.com
NULOADER_API_KEY=
# days_7 = expires in 7 days, unlimited downloads
# downloads_5 = deleted after 5 downloads (30 day hard cap)
NULOADER_EXPIRY_MODE=days_7
