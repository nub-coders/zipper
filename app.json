{
  "name": "File Zipper Bot",
  "description": "A Telegram bot that compresses, manages, and uncompresses files.",
  "repository": "https://github.com/nub-coders/zipper",
  "logo": "https://www.herokucdn.com/deploy/button.svg",
  "keywords": ["telegram", "bot", "zip", "file-manager", "python"],
  "buildpacks": [
    { "url": "https://github.com/heroku/heroku-buildpack-apt" },
    { "url": "heroku/python" }
  ],
  "env": {
    "API_ID": {
      "description": "Your Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Your Telegram API Hash from my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Your Telegram Bot Token from @BotFather",
      "required": true
    },
    "BOT_USERNAME": {
      "description": "Your bot's username (without @)",
      "required": true
    },
    "MONGO_URL": {
      "description": "MongoDB connection URI",
      "required": true
    },
    "RAZORPAY_KEY_ID": {
      "description": "Razorpay API Key ID (for premium payments)",
      "required": false
    },
    "RAZORPAY_KEY_SECRET": {
      "description": "Razorpay API Key Secret (for premium payments)",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "stack": "heroku-24"
}
